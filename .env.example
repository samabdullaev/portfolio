# Sanity CMS — required for the app to fetch content.
# Project ID + dataset name are public-readable (embedded in client URLs)
# but env-driven so the same code can target multiple datasets.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Shared secret for the on-demand revalidation webhook at
# /api/revalidate. Generate with `openssl rand -base64 32` and set the
# same value in Sanity Studio → Manage → API → Webhooks → URL query
# string (?secret=<value>). Without this set, the webhook returns 500.
SANITY_REVALIDATE_SECRET=
