# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright screenshots (ignore stray PNGs at repo root, but keep
# app/public assets and committed visual-regression baselines under e2e/)
*.png
!src/app/**/*.png
!public/**/*.png
!e2e/**/*.png
.playwright-mcp/
screenshots/

# playwright test outputs — re-generated each run, never committed
/test-results/
/playwright-report/

# pnpm
pnpm-lock.yaml

# site reference (removed)
/site/

# claude code local state
/.claude/

# personal working docs — not for the public repo
/BACKLOG.md
/CLAUDE.md
/PLAN.md
/SANITY_STRUCTURE.md
